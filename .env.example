# Run `npm run setup` to generate .env automatically.
# Never commit .env to git or send it to customers.
SESSION_SECRET=replace_with_64_random_hex_characters
ADMIN_PASSWORD_HASH=replace_with_scrypt_salt_colon_hash
SQLITE_PATH=./.data/chits-store.sqlite
NODE_ENV=development
# Set to the exact HTTPS origin in production, e.g. https://store.example.com.
# Leave unset for local development on localhost or 127.0.0.1.
# PUBLIC_ORIGIN=https://store.example.com
# Only enable behind the supplied Nginx proxy, with Node bound to loopback.
# TRUST_PROXY=1
# Folder holding the jukebox's tracks.json and MP3 files (default ./music).
# JUKEBOX_DIR=./music
